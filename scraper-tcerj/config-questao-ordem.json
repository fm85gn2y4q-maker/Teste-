{
  "base_url": "https://www.tcerj.tc.br",
  "portais": [
    "/cadastro-publicacoes/public/questao-ordem"
  ],
  "backend": "api",
  "api": {
    "url": "https://www.tcerj.tc.br/liana-processo-webapi/questaoordem/consulta/pagina/{pagina}/tamanhoPagina/{tamanho}",
    "metodo": "POST",
    "cabecalhos": {
      "Accept": "application/json",
      "Content-Type": "application/json"
    },
    "parametros": {},
    "corpo": {},
    "campo_pagina": "pagina",
    "campo_tamanho": "tamanhoPagina",
    "campo_termo": "texto",
    "primeira_pagina": 1,
    "tamanho_pagina": 50,
    "caminho_itens": "list",
    "caminho_total": "totalResults"
  },
  "seletores": {
    "campo_busca": "input[type='search'], input[type='text']",
    "botao_buscar": "button[type='submit']",
    "item_resultado": "table tbody tr",
    "link_detalhe": "a[href]",
    "proxima_pagina": "a[rel='next'], .pagination .next",
    "corpo_detalhe": "main, .conteudo, article, body"
  },
  "intervalo_seg": 1.5,
  "concorrencia": 2,
  "timeout_seg": 45.0,
  "tentativas": 4,
  "user_agent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/125.0 Safari/537.36 (pesquisa-academica; contato via repositorio)",
  "respeitar_robots": true,
  "diretorio_saida": "dados",
  "caminho_navegador": null
}
