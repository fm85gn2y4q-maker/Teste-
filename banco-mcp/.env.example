# Provedor de dados: "mock" (demonstracao, sem credencial) ou "pluggy" (Open Finance real).
BANCO_MCP_PROVEDOR=mock

# --- Modo HTTP (opcional; o padrao e stdio) ---
# Porta e host do transporte HTTP. Host padrao 127.0.0.1: nao exponha na rede sem necessidade.
PORT=8787
BANCO_MCP_HOST=127.0.0.1
# Token exigido no header Authorization: Bearer <token>. Sem ele, qualquer processo
# que alcance a porta le seus dados bancarios.
BANCO_MCP_TOKEN=

# --- Pluggy (apenas com BANCO_MCP_PROVEDOR=pluggy) ---
# Credenciais da aplicacao no painel da Pluggy.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# Ids dos itens: cada banco conectado pelo Pluggy Connect gera um item.
PLUGGY_ITEM_IDS=
PLUGGY_BASE_URL=https://api.pluggy.ai

# Rotulos manuais de instituicao, quando o conector agrega varios bancos numa
# conexao so (Meu Pluggy). Chave = id da conta, valor = nome do banco.
# O comando "npm run diagnostico" imprime os ids e monta esta linha para voce.
BANCO_MCP_INSTITUICOES=

# Porta da pagina local de conexao (npm run conectar).
BANCO_MCP_PORTA_CONEXAO=8788
# Sobrescreva se a versao do widget Pluggy Connect mudar.
PLUGGY_CONNECT_URL=
